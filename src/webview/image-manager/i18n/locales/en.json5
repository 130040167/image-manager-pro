    "similarity_algorithm_histogram_short": "Color distribution",
    "similarity_algorithm_hybrid_desc": "Hybrid combines pHash structure with a color histogram so edited copies still match while recolored look-alikes are less likely to match.",
    "similarity_algorithm_phash_desc": "pHash compares low-frequency image structure and tolerates resize, compression, brightness, and mild contrast changes.",
    "similarity_algorithm_dhash_desc": "dHash compares local brightness gradients. It is fast and strict, but can miss crops or heavier edits.",
    "similarity_algorithm_ahash_desc": "aHash compares pixels against the average brightness. It is simple and strict, but sensitive to broad tone changes.",
    "similarity_algorithm_histogram_desc": "Histogram compares RGB and intensity distribution. It can match similar palettes even when the layout differs.",
    "similarity_algorithm_hybrid_use_case": "Recommended for ordinary folders with screenshots, photos, exports, and edited copies.",
    "similarity_algorithm_phash_use_case": "Use when resized or compressed copies should match even if colors shift slightly.",
    "similarity_algorithm_dhash_use_case": "Use for quick duplicate scans of simple resized images.",
    "similarity_algorithm_ahash_use_case": "Use for simple icons, diagrams, and low-edit duplicates.",
    "similarity_algorithm_histogram_use_case": "Use when color palette matters more than exact geometry.",
